---
import { getEntry } from 'astro:content';
import SectionLabel from '../global/SectionLabel.astro';
import ArrowLink from '../global/ArrowLink.astro';
import FlowDiagram from '../diagrams/FlowDiagram.astro';

const entry = await getEntry('work', 'enterprise-android');
const fleetMarks = Array.from({ length: 24 });
---

<section id="enterprise-android" class="chapter chapter-dark render-contained" data-chapter-theme="dark" aria-labelledby="ea-heading">
  <div class="container ea-grid">
    <div class="ea-copy">
      <SectionLabel number="02" label="ENTERPRISE ANDROID" />
      <p class="scale-number" aria-hidden="true">15,000+</p>
      <h2 id="ea-heading" class="type-chapter balance">TRANSIT<br />DEVICES.</h2>
      <p class="type-support ea-intro">
        Enterprise Android software operating across a production device fleet.
      </p>
      <p class="type-body ea-desc">{entry?.data.summary}</p>
      <ArrowLink href="/work/enterprise-android" direction="deeper">Read the case study</ArrowLink>
    </div>

    <div class="ea-visual">
      <FlowDiagram
        steps={['DEVICE FLEET', 'EDGE APPLICATION', 'REST API LAYER', 'CLOUD SERVICES', 'ANALYTICS / DATA']}
        class="ea-diagram"
      />
      <div class="fleet-marks" role="presentation">
        {fleetMarks.map(() => <span class="fleet-mark"></span>)}
      </div>
    </div>
  </div>
</section>

<style>
  .ea-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
  }

  .scale-number {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(3.5rem, 2.5rem + 8vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--warm-white);
    margin-top: var(--space-8);
  }

  .ea-intro {
    margin-top: var(--space-6);
    color: var(--warm-white);
    max-width: 40ch;
  }

  .ea-desc {
    margin-top: var(--space-4);
    color: var(--stone);
    max-width: 52ch;
  }

  .ea-copy > :global(.arrow-link) {
    margin-top: var(--space-8);
  }

  .ea-diagram {
    color: var(--warm-white);
  }

  .fleet-marks {
    margin-top: var(--space-12);
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: var(--space-2);
    max-width: 20rem;
  }

  .fleet-mark {
    aspect-ratio: 1;
    background: var(--border-dark);
  }

  @media (min-width: 900px) {
    .ea-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }
  }
</style>
