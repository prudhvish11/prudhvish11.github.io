---
import { getEntry } from 'astro:content';
import ArrowLink from '../global/ArrowLink.astro';
import SectionLabel from '../global/SectionLabel.astro';
import FlowDiagram from '../diagrams/FlowDiagram.astro';

const detox = await getEntry('work', 'detox');
---

<section id="detox" class="chapter chapter-light render-contained" data-chapter-theme="light" aria-labelledby="detox-heading">
  <div class="container detox-grid">
    <div class="detox-copy">
      <SectionLabel number="05" label="COLLEGE RESEARCH / TEAM PROJECT / 2024" />
      <h2 id="detox-heading" class="type-project balance">DETOX.<br />TOXIC COMMENT<br />DETECTION + MODERATION.</h2>
      <p class="type-body detox-desc">{detox?.data.summary}</p>
      <p class="type-meta">{detox?.data.technologies.join(' / ')}</p>
      <ArrowLink href={detox?.data.externalUrl ?? '/work/detox'} direction="external" external>IEEE Publication</ArrowLink>
    </div>

    <FlowDiagram
      class="detox-diagram"
      steps={['VIDEO URL', 'YOUTUBE DATA API', 'COMMENT RETRIEVAL', 'TEXT PREPROCESSING', 'TOXICITY MODEL', 'MODERATION UI', 'KEEP / REVIEW / REMOVE']}
    />
  </div>
</section>

<style>
  .detox-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-16);
  }

  .detox-copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .detox-desc {
    max-width: 52ch;
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .detox-grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: center;
    }
  }
</style>
