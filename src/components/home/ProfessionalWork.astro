---
import { getEntry } from 'astro:content';
import SectionLabel from '../global/SectionLabel.astro';
import ArrowLink from '../global/ArrowLink.astro';
import FlowDiagram from '../diagrams/FlowDiagram.astro';

const enterpriseAndroid = await getEntry('work', 'enterprise-android');
const rag = await getEntry('work', 'rag-code-intelligence');
---

<section id="work" class="chapter chapter-dark render-contained" data-chapter-theme="dark" aria-labelledby="work-heading">
  <div class="container">
    <SectionLabel number="02" label="SELECTED WORK" />

    <h2 id="work-heading" class="type-chapter balance">WORK AT<br />REAL SCALE.</h2>
    <p class="type-support work-intro">
      Professional systems, built and shipped at a scale that leaves little room for guessing.
    </p>

    <div class="work-grid">
      <article class="work-card work-card--wide">
        <p class="type-meta">{enterpriseAndroid?.data.labels.join(' / ')}</p>
        <p class="scale-number" aria-hidden="true">15,000+</p>
        <p class="type-support">{enterpriseAndroid?.data.homepageSummary}</p>
        <p class="type-body work-desc">{enterpriseAndroid?.data.summary}</p>
        <FlowDiagram steps={['CLOUD', 'API LAYER', 'DEVICE FLEET']} class="work-diagram" />
        <ArrowLink href="/work/enterprise-android" direction="deeper">Read the case study</ArrowLink>
      </article>

      <article class="work-card">
        <p class="type-meta">{rag?.data.labels.join(' / ')}</p>
        <h3 class="type-project work-title">RAG Code<br />Intelligence</h3>
        <p class="type-body work-desc">{rag?.data.summary}</p>
        <FlowDiagram
          steps={['QUERY', 'RETRIEVAL', 'FILES / REPOSITORY CONTEXT', 'CONTEXT CONSTRUCTION', 'CODE ANALYSIS']}
          class="work-diagram"
        />
        <ArrowLink href="/work/rag-code-intelligence" direction="deeper">Read the case study</ArrowLink>
      </article>
    </div>
  </div>
</section>

<style>
  .work-intro {
    max-width: 40ch;
    margin-top: var(--space-6);
    color: var(--stone);
  }

  .work-grid {
    margin-top: var(--space-16);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .work-card {
    border: 1px solid var(--border-dark);
    padding: var(--space-8) var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    transition:
      transform var(--duration-medium) var(--ease-standard),
      border-color var(--duration-medium) var(--ease-standard);
  }

  .work-card:hover,
  .work-card:focus-within {
    transform: scale(1.015);
    border-color: var(--maroon);
  }

  .scale-number {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(3.5rem, 2.5rem + 8vw, 8rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    color: var(--warm-white);
  }

  .work-title {
    color: var(--warm-white);
  }

  .work-desc {
    color: var(--stone);
    max-width: 52ch;
  }

  .work-diagram {
    color: var(--warm-white);
    margin-block: var(--space-4);
  }

  @media (min-width: 900px) {
    .work-grid {
      grid-template-columns: 1.4fr 1fr;
      align-items: start;
    }

    .work-card--wide {
      padding: var(--space-12);
    }
  }
</style>
