---
import { Image } from 'astro:assets';
import heroPhoto from '../../assets/photos/hero_maroon_original.jpeg';
---

<section class="hero chapter-light" data-chapter-theme="light" aria-label="Introduction">
  <div class="container hero-grid">
    <div class="hero-intro">
      <p class="section-label" style="margin-bottom: var(--space-6);">
        <span>SOFTWARE ENGINEER</span>
        <span class="rule" aria-hidden="true"></span>
      </p>

      <h1 class="type-hero">
        <span class="is-strong">PRUDHVISH</span>
        <span class="is-light">NARAYANAM</span>
      </h1>

      <p class="type-support hero-body">
        I build products, work on real systems, explore ideas and write about what I learn.
      </p>
    </div>

    <figure class="hero-photo">
      <Image
        src={heroPhoto}
        alt="Prudhvish Narayanam standing outdoors at dusk"
        widths={[480, 768, 1024, 1440]}
        sizes="(min-width: 1200px) 46vw, (min-width: 700px) 60vw, 92vw"
        loading="eager"
        fetchpriority="high"
        quality={82}
      />
    </figure>

    <div class="hero-tail">
      <p class="type-meta hero-meta">SOFTWARE / MOBILE / AI / SYSTEMS</p>

      <a href="#work" class="cta-circle hero-cta">
        <span class="circle" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
            <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
        <span class="label">Explore my work</span>
      </a>
    </div>

    <p class="hero-location type-meta">BENGALURU<br />INDIA</p>
  </div>

  <div class="container hero-footer-row">
    <span class="type-meta">01</span>
    <span class="scroll-cue" aria-hidden="true">↓</span>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(1.5rem, 1rem + 2vw, 3rem);
    display: flex;
    flex-direction: column;
    min-height: 92svh;
  }

  .hero-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    flex: 1;
  }

  .hero-intro {
    order: 2;
  }

  .hero-photo {
    order: 1;
    aspect-ratio: 4 / 3;
  }

  .hero-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .hero-body {
    max-width: 30ch;
    margin-top: var(--space-6);
  }

  .hero-tail {
    order: 3;
  }

  .hero-meta {
    margin-top: var(--space-8);
  }

  .hero-cta {
    margin-top: var(--space-12);
  }

  .hero-location {
    display: none;
  }

  .hero-footer-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-6);
  }

  .scroll-cue {
    color: var(--maroon);
  }

  /* Tablet portrait — text leads, photo sits between body and metadata */
  @media (min-width: 700px) {
    .hero-intro {
      order: 1;
    }

    .hero-photo {
      order: 2;
      aspect-ratio: 5 / 4;
    }

    .hero-tail {
      order: 3;
    }
  }

  /* Tablet landscape / small desktop — two columns */
  @media (min-width: 900px) and (max-width: 1199px) {
    .hero-grid {
      display: grid;
      grid-template-columns: 0.9fr 1.1fr;
      column-gap: var(--space-8);
      align-items: center;
    }

    .hero-intro {
      order: 1;
      grid-column: 1 / 2;
      grid-row: 1;
    }

    .hero-tail {
      order: 2;
      grid-column: 1 / 2;
      grid-row: 2;
    }

    .hero-photo {
      grid-column: 2 / 3;
      grid-row: 1 / 3;
      aspect-ratio: 4 / 5;
    }
  }

  /* Large desktop — magazine spread */
  @media (min-width: 1200px) {
    .hero-grid {
      display: grid;
      grid-template-columns: 5fr 1fr 6fr;
      column-gap: var(--space-8);
      align-items: start;
    }

    .hero-intro {
      grid-column: 1 / 2;
      grid-row: 1;
      padding-top: clamp(0.5rem, 1vw, 1.5rem);
    }

    .hero-tail {
      grid-column: 1 / 2;
      grid-row: 2;
      margin-top: var(--space-8);
    }

    .hero-photo {
      grid-column: 3 / 4;
      grid-row: 1 / 3;
      aspect-ratio: 4 / 5;
      margin-top: clamp(1.5rem, 3vw, 3.5rem);
    }

    .hero-location {
      display: block;
      grid-column: 3 / 4;
      grid-row: 3;
      text-align: right;
    }

    .hero-body {
      max-width: 26ch;
    }
  }
</style>
