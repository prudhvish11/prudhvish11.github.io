---
const signals = [
  'ACE AWARD / 2026',
  'PROMOTED TO ANALYST / 2026',
  'IEEE PUBLICATION / 2024',
  'AZURE AI FUNDAMENTALS',
  'IBM AI ENGINEERING',
];
---

<div class="signals-strip">
  <p class="type-meta signals-label">SELECTED SIGNALS</p>
  <ul class="signals-list type-meta">
    {signals.map((signal) => <li>{signal}</li>)}
  </ul>
</div>

<style>
  .signals-strip {
    margin-top: var(--space-16);
    padding-top: var(--space-8);
    border-top: 1px solid var(--border-light);
  }

  .signals-list {
    margin-top: var(--space-4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-8);
  }
</style>
