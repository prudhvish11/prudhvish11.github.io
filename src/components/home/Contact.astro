---
import SectionLabel from '../global/SectionLabel.astro';
---

<section id="contact" class="chapter chapter-dark contact-section" data-chapter-theme="dark" aria-labelledby="contact-heading">
  <div class="container">
    <SectionLabel number="09" label="CONTACT" />
    <h2 id="contact-heading" class="type-chapter balance">
      HAVE SOMETHING<br />INTERESTING<br />TO BUILD?
    </h2>
    <a href="mailto:prudhvish11@gmail.com" class="cta-circle contact-cta">
      <span class="circle" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 12L12 4M12 4H5M12 4V11" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="label">Let's talk</span>
    </a>
  </div>
</section>

<style>
  .contact-section {
    padding-bottom: var(--space-24);
  }

  .contact-cta {
    margin-top: var(--space-12);
    font-size: 1.25rem;
  }
</style>
