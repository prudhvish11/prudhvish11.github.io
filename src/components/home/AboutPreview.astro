---
import { Image } from 'astro:assets';
import SectionLabel from '../global/SectionLabel.astro';
import ArrowLink from '../global/ArrowLink.astro';
import mainPhoto from '../../assets/photos/about_track_night_portrait_original.jpeg';

const interests = ['WRITING', 'BADMINTON', 'FITNESS', 'TRAVEL', 'LEARNING'];
---

<section class="chapter chapter-light render-contained" data-chapter-theme="light" aria-labelledby="about-heading">
  <div class="container about-grid">
    <div class="about-copy">
      <SectionLabel number="08" label="ABOUT / BEYOND CODE" />

      <h2 id="about-heading" class="type-chapter balance">BEYOND<br />THE CODE.</h2>
      <p class="type-support about-lead">
        I like building things, understanding how they work, and keeping enough space outside work to stay curious.
      </p>
      <p class="type-body about-secondary">
        Writing, badminton, fitness, travel and learning usually fill that space.
      </p>

      <ul class="interest-list" aria-label="Interests">
        {interests.map((interest, index) => (
          <li>
            <span class="type-meta interest-index">{String(index + 1).padStart(2, '0')}</span>
            <span>{interest}</span>
          </li>
        ))}
      </ul>

      <ArrowLink href="/about" direction="deeper" class="about-more">More about me</ArrowLink>
    </div>

    <figure class="about-photo">
      <Image
        src={mainPhoto}
        alt="Prudhvish at a go-kart track at night, looking back over his shoulder"
        widths={[480, 768, 1024, 1280]}
        sizes="(min-width: 900px) 46vw, 92vw"
        loading="lazy"
        quality={82}
      />
      <figcaption class="type-meta">OUTSIDE WORK / 01</figcaption>
    </figure>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-16);
  }

  .about-lead {
    margin-top: var(--space-6);
    max-width: 34ch;
  }

  .about-secondary {
    margin-top: var(--space-4);
    max-width: 42ch;
    color: var(--stone);
  }

  .interest-list {
    margin-top: var(--space-10, 2.5rem);
    border-top: 1px solid var(--border-light);
  }

  .interest-list li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--border-light);
    font-size: clamp(1rem, 0.95rem + 0.35vw, 1.2rem);
  }

  .interest-index {
    color: var(--maroon);
  }

  .about-more {
    margin-top: var(--space-8);
  }

  .about-photo {
    align-self: end;
  }

  .about-photo :global(img) {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 76% 28%;
  }

  .about-photo figcaption {
    margin-top: var(--space-3);
    text-align: right;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: minmax(22rem, 0.8fr) minmax(0, 1.2fr);
      gap: clamp(3rem, 7vw, 8rem);
      align-items: end;
    }

    .about-copy {
      padding-bottom: var(--space-8);
    }
  }
</style>
