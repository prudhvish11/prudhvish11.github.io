---
import { Image } from 'astro:assets';
import SectionLabel from '../global/SectionLabel.astro';
import ArrowLink from '../global/ArrowLink.astro';
import Recognition from './Recognition.astro';
import mainPhoto from '../../assets/photos/about-night-track-looking-back-original.jpeg';

const labels = ['I BUILD.', 'I WRITE.', 'I TRAIN.', 'I PLAY.', 'I TRAVEL.', 'I KEEP LEARNING.'];
---

<section id="about" class="chapter chapter-light render-contained" data-chapter-theme="light" aria-labelledby="about-heading">
  <div class="container about-grid">
    <div class="about-copy">
      <SectionLabel number="09" label="ABOUT / BEYOND CODE" />
      <h2 id="about-heading" class="type-chapter balance">BEYOND<br />THE CODE.</h2>
      <p class="type-support">
        I like building things, understanding how they work, and keeping enough space outside work to stay curious.
      </p>

      <ul class="interest-list type-meta">
        {labels.map((label) => <li>{label}</li>)}
      </ul>

      <ArrowLink href="/about" direction="deeper" class="about-more">More about me</ArrowLink>
    </div>

    <figure class="media-frame about-photo">
      <Image src={mainPhoto} alt="Prudhvish at a go-kart track at night, looking back over his shoulder" widths={[480, 768, 1024]} sizes="(min-width: 900px) 36vw, 80vw" loading="lazy" />
    </figure>

    <div class="signals-wrap">
      <Recognition />
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-12);
  }

  .interest-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4) var(--space-6);
    margin-top: var(--space-8);
  }

  .about-more {
    margin-top: var(--space-8);
  }

  .about-photo {
    aspect-ratio: 3 / 4;
  }

  .about-photo :global(img) {
    object-position: 80% 30%;
  }

  .signals-wrap {
    grid-column: 1 / -1;
  }

  @media (min-width: 900px) {
    .about-grid {
      grid-template-columns: 1.2fr 1fr;
      align-items: center;
    }

    .about-copy {
      max-width: 42ch;
    }

    .about-photo {
      aspect-ratio: 4 / 5;
      max-width: 24rem;
      margin-inline-start: auto;
    }
  }
</style>
