---
import SectionLabel from '../global/SectionLabel.astro';
import SystemsMap from '../diagrams/SystemsMap.astro';

const skills = [
  { label: 'LANGUAGES', value: 'Java / Python / SQL' },
  { label: 'BACKEND', value: 'FastAPI / Flask / REST', system: 'backend' },
  { label: 'AI', value: 'RAG / NLP / ML / Computer Vision', system: 'ai' },
  { label: 'TOOLS', value: 'Git / Docker / Azure DevOps / Android Studio' },
];

const roles = [
  { title: 'Software Engineer Intern', period: 'Mar — Jun 2024' },
  { title: 'Associate', period: 'Oct 2024 — May 2026' },
  { title: 'Analyst', period: 'May 2026 — Now' },
];
---

<section class="chapter chapter-dark render-contained" data-chapter-theme="dark" aria-labelledby="systems-heading">
  <div class="container">
    <SectionLabel number="07" label="ENGINEERING + EXPERIENCE" />

    <h2 id="systems-heading" class="type-chapter balance">SYSTEMS<br />OVER<br />BUZZWORDS.</h2>
    <p class="type-support systems-intro">
      I work across mobile, backend and intelligent systems — usually where data has to move reliably between them.
    </p>

    <div class="systems-map-wrap">
      <SystemsMap />
    </div>

    <p class="type-meta sub-label">CORE STACK</p>
    <div class="skills-grid">
      {skills.map((skill) => (
        <div class="skill-block" data-system={skill.system}>
          <p class="type-meta">{skill.label}</p>
          <p class="skill-value">{skill.value}</p>
        </div>
      ))}
    </div>

    <p class="type-meta sub-label">CAREER</p>
    <div class="experience-track" aria-label="Career progression at Accenture">
      <p class="type-meta track-years"><span>2024</span><span>NOW</span></p>
      <div class="track-line" aria-hidden="true"></div>
      <div class="track-roles">
        {roles.map((role) => (
          <div class="track-role">
            <p class="role-title">{role.title}</p>
            <p class="type-meta">{role.period}</p>
          </div>
        ))}
      </div>
      <p class="type-meta track-company">ACCENTURE</p>
    </div>
  </div>
</section>

<style>
  .systems-intro {
    max-width: 46ch;
    margin-top: var(--space-6);
    color: var(--stone);
  }

  .systems-map-wrap {
    margin-top: var(--space-16);
    padding-block: var(--space-8);
  }

  .sub-label {
    margin-top: var(--space-16);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--border-dark);
  }

  .skills-grid {
    margin-top: var(--space-8);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .skill-block {
    opacity: 1;
    transition: opacity var(--duration-medium) var(--ease-standard);
  }

  .skill-value {
    margin-top: var(--space-2);
    font-size: 1.1rem;
    color: var(--warm-white);
    transition: color var(--duration-medium) var(--ease-standard);
  }

  /* Cross-highlight the matching skill when its systems-map node is hovered/focused */
  .systems-map-wrap:has(button[data-map-node='ai']:hover) ~ .skills-grid .skill-block:not([data-system='ai']),
  .systems-map-wrap:has(button[data-map-node='ai']:focus-visible) ~ .skills-grid .skill-block:not([data-system='ai']),
  .systems-map-wrap:has(button[data-map-node='backend']:hover) ~ .skills-grid .skill-block:not([data-system='backend']),
  .systems-map-wrap:has(button[data-map-node='backend']:focus-visible) ~ .skills-grid .skill-block:not([data-system='backend']),
  .systems-map-wrap:has(button[data-map-node='mobile']:hover) ~ .skills-grid .skill-block,
  .systems-map-wrap:has(button[data-map-node='mobile']:focus-visible) ~ .skills-grid .skill-block,
  .systems-map-wrap:has(button[data-map-node='data']:hover) ~ .skills-grid .skill-block,
  .systems-map-wrap:has(button[data-map-node='data']:focus-visible) ~ .skills-grid .skill-block {
    opacity: 0.4;
  }

  .systems-map-wrap:has(button[data-map-node='ai']:hover) ~ .skills-grid .skill-block[data-system='ai'],
  .systems-map-wrap:has(button[data-map-node='ai']:focus-visible) ~ .skills-grid .skill-block[data-system='ai'],
  .systems-map-wrap:has(button[data-map-node='backend']:hover) ~ .skills-grid .skill-block[data-system='backend'],
  .systems-map-wrap:has(button[data-map-node='backend']:focus-visible) ~ .skills-grid .skill-block[data-system='backend'] {
    opacity: 1;
  }

  .systems-map-wrap:has(button[data-map-node='ai']:hover) ~ .skills-grid .skill-block[data-system='ai'] .skill-value,
  .systems-map-wrap:has(button[data-map-node='ai']:focus-visible) ~ .skills-grid .skill-block[data-system='ai'] .skill-value,
  .systems-map-wrap:has(button[data-map-node='backend']:hover) ~ .skills-grid .skill-block[data-system='backend'] .skill-value,
  .systems-map-wrap:has(button[data-map-node='backend']:focus-visible) ~ .skills-grid .skill-block[data-system='backend'] .skill-value {
    color: var(--maroon);
  }

  .experience-track {
    margin-top: var(--space-8);
  }

  .track-years {
    max-width: none;
    display: flex;
    justify-content: space-between;
  }

  .track-line {
    position: relative;
    height: 1px;
    background: var(--border-dark);
    margin-block: var(--space-4);
  }

  .track-line::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle, var(--maroon) 2.5px, transparent 2.6px) 0% 50%,
      radial-gradient(circle, var(--maroon) 2.5px, transparent 2.6px) 50% 50%,
      radial-gradient(circle, var(--maroon) 3px, transparent 3.1px) 100% 50%;
    background-repeat: no-repeat;
  }

  .track-roles {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-6);
  }

  .role-title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--warm-white);
  }

  .track-company {
    max-width: none;
    text-align: center;
    letter-spacing: 0.15em;
    color: var(--warm-white);
    font-weight: 600;
    margin-top: var(--space-8);
  }

  @media (min-width: 700px) {
    .skills-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 900px) {
    .skills-grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .track-roles {
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
    }

    .track-role:first-child {
      text-align: left;
    }

    .track-role:last-child {
      text-align: right;
    }
  }
</style>
